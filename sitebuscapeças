import React, { useState } from 'react';

function BuscaPecas() {
    const [pecas, setPecas] = useState([]);
    const [filtros, setFiltros] = useState({ marca: '', modelo: '', ano: '' });

    const buscarPecas = async () => {
        const response = await fetch(
            `/api/pecas?marca=${filtros.marca}&modelo=${filtros.modelo}&ano=${filtros.ano}`
        );
        const data = await response.json();
        setPecas(data);
    };

    return (
        <div>
            <input placeholder="Marca" onChange={(e) => setFiltros({...filtros, marca: e.target.value})} />
            <button onClick={buscarPecas}>Buscar</button>
            {pecas.map(peca => <div key={peca.id}>{peca.nome}</div>)}
        </div>
    );
}
